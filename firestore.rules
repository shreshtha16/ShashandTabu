rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * IMPORTANT:
     * Replace the two placeholder emails below with the exact email
     * addresses you use for the two Firebase Authentication accounts.
     *
     * Authentication + these rules are the real protection.
     * Do not rely on a client-side passphrase.
     */
    function isUs() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "muskanpandey8076@gmail.com",
          "shreshthatiwari24@gmail.com"
        ];
    }

    match /notes/{noteId} {
      allow read: if isUs();
      allow create: if isUs()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 280;
      allow update: if isUs()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions is map
        && ((!resource.data.keys().hasAny(['reactions'])
          && request.resource.data.reactions.keys().hasOnly([request.auth.uid]))
          || (resource.data.keys().hasAny(['reactions'])
          && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if isUs();
    }

    match /bucketItems/{itemId} {
      allow read: if isUs();
      allow create: if isUs()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 120;
      allow update, delete: if isUs();
    }

    match /memories/{memoryId} {
      allow read: if isUs();
      allow create: if isUs()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.url is string
        && request.resource.data.storagePath is string;
      allow update, delete: if isUs();
    }

    match /privateLetters/{letterId} {
      allow read: if isUs();
      allow create: if isUs()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.body.size() <= 5000;
      allow update, delete: if isUs();
    }

    match /notificationTokens/{userId} {
      allow read: if isUs() && request.auth.uid == userId;
      allow create, update: if isUs()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string;
      allow delete: if isUs() && request.auth.uid == userId;
    }

    match /streaks/{streakId} {
      allow read: if isUs();
      allow create: if isUs() && streakId == 'shared'
        && request.resource.data.count == 1
        && request.resource.data.lastOpenedByUid == request.auth.uid
        && request.resource.data.lastOpenDate is string;
      allow update: if isUs() && streakId == 'shared'
        && request.resource.data.lastOpenedByUid == request.auth.uid
        && request.resource.data.count is int
        && request.resource.data.lastOpenDate is string
        && request.resource.data.lastOpenDate >= resource.data.lastOpenDate;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
